# ─────────────────────────────────────────────────────────────
# BookIt — server environment configuration
# Copy this file to `server/.env` and fill in the values.
# NEVER commit your real `.env` — only this example is tracked.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# URL-encode any special characters in the password (e.g. # -> %23, @ -> %40).
#
# Supabase: Project → Connect → "Session pooler" URI (port 5432). The direct
# connection is IPv6-only and fails on many networks; the transaction pooler
# (port 6543) is not recommended for a long-running server.
# DATABASE_URL=postgresql://postgres.<project-ref>:YOUR_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Local Postgres (the database is created by `npm run db:migrate` if missing):
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/appointments

# TLS is on automatically for non-localhost hosts; set to force it on/off.
# DB_SSL=true

# ── Database connection pool (optional — defaults shown) ──
# Max simultaneous connections held by this server instance.
# DB_POOL_MAX=10
# How long an idle connection stays open before being closed.
# DB_POOL_IDLE_TIMEOUT_MS=30000
# How long to wait for a connection from the pool before failing.
# DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ── Server ──
PORT=4000
# Timezone the clinic's schedule is written in (IANA name). Defaults to Asia/Karachi.
# CLINIC_TIMEZONE=Asia/Karachi
# Secret used to sign admin JWTs. Generate a strong one for production:
#   openssl rand -base64 32
JWT_SECRET=change-me-in-production
# Origin allowed by CORS (your client dev server).
CLIENT_ORIGIN=http://localhost:5173
